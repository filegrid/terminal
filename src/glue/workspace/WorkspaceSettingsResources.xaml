<!--
  Workspace-private copy of the settings editor's standard field presentation.
  Keep this dictionary independent from Microsoft.Terminal.Settings.Editor so
  the original Settings tab has no resource or control dependency on workspaces.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Reuse the Settings editor's complete control templates without
             modifying that editor or its resource dictionary. -->
        <ResourceDictionary Source="ms-appx:///Microsoft.Terminal.Settings.Editor/CommonResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <x:Double x:Key="WorkspaceContentMaxWidth">760</x:Double>

    <Style x:Key="WorkspaceSettingsStackStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="{StaticResource WorkspaceContentMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WorkspaceTextBoxSettingStyle" TargetType="TextBox">
        <Setter Property="MinWidth" Value="400" />
        <Setter Property="MaxWidth" Value="640" />
    </Style>

    <Style x:Key="WorkspaceComboBoxSettingStyle" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="400" />
    </Style>

    <!-- Keep the workspace key private while inheriting the complete original
         ToggleSwitch template, including its visual state layout. -->
    <Style x:Key="WorkspaceToggleSwitchStyle"
           TargetType="ToggleSwitch"
           BasedOn="{StaticResource ToggleSwitchInExpanderStyle}" />

    <Style x:Key="WorkspaceNodeOrderItemStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource ExpanderHeaderBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource ExpanderHeaderBorderThickness}" />
    </Style>

    <Style x:Key="WorkspaceSettingHeaderStyle" TargetType="TextBlock">
        <Setter Property="Style" Value="{StaticResource BodyTextBlockStyle}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="WorkspaceSettingDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Style" Value="{StaticResource CaptionTextBlockStyle}" />
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <!-- Copied from the non-expander branch of SettingContainerStyle.xaml.
         Tag is the setting header; Content is the workspace-owned editor. -->
    <Style x:Key="WorkspaceSettingContainerStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MaxWidth" Value="{StaticResource WorkspaceContentMaxWidth}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="{ThemeResource ExpanderHeaderBackground}"
                          MinWidth="{ThemeResource FlyoutThemeMinWidth}"
                          MinHeight="64"
                          BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          Padding="16,12,16,12"
                          HorizontalAlignment="Stretch"
                          CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource WorkspaceSettingHeaderStyle}"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Tag}" />
                        <ContentPresenter Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Style" Value="{StaticResource SubtitleTextBlockStyle}" />
        <Setter Property="Margin" Value="0,32,0,4" />
    </Style>
</ResourceDictionary>
