<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="GeekTerminal"
           Manufacturer="FileGrid"
           Version="$(var.ProductVersion)"
           UpgradeCode="{DD0A9B56-6A8F-454C-85D3-16401321064B}"
           Scope="perMachine">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="GeekTerminal has been installed successfully." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch GeekTerminal" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixUnelevatedShellExecTarget" Value="[#GeekTerminalExe]" />
    <CustomAction Id="LaunchGeekTerminal"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixUnelevatedShellExec"
                  Execute="immediate"
                  Return="ignore" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchGeekTerminal"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="FILEGRIDFOLDER" Name="FileGrid">
        <Directory Id="INSTALLFOLDER" Name="Terminal">
          <Component Id="GeekTerminal" Bitness="always64">
            <File Id="GeekTerminalExe" Source="$(var.ProductLayout)\GeekTerminal.exe" KeyPath="yes">
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="GeekTerminal"
                        WorkingDirectory="INSTALLFOLDER" />
            </File>
          </Component>
          <Files Include="$(var.ProductLayout)\**">
            <Exclude Files="$(var.ProductLayout)\GeekTerminal.exe" />
          </Files>
          <Component Id="ProductRegistration" Bitness="always64">
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RegistryValue Root="HKLM"
                         Key="Software\FileGrid\GeekTerminal"
                         Name="InstallLocation"
                         Type="string"
                         Value="[INSTALLFOLDER]" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

  </Package>
</Wix>
