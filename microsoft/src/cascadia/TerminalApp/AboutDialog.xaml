<ContentDialog x:Class="TerminalApp.AboutDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:TerminalApp"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:mtu="using:Microsoft.Terminal.UI"
               x:Uid="AboutDialog"
               DefaultButton="Close"
               Style="{StaticResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <TextBlock IsTextSelectionEnabled="True">
            <TextBlock.ContextFlyout>
                <mtu:TextMenuFlyout />
            </TextBlock.ContextFlyout>
            <Run x:Uid="AboutDialog_DisplayName"
                 AutomationProperties.HeadingLevel="1" /> <LineBreak />
            <Run x:Uid="AboutDialog_VersionLabel" />
            <Run Text="{x:Bind ApplicationVersion}" />
        </TextBlock>

        <TextBlock Margin="0,4,0,0"
                   IsTextSelectionEnabled="True">
            <TextBlock.ContextFlyout>
                <mtu:TextMenuFlyout />
            </TextBlock.ContextFlyout>
            <Run x:Uid="AboutDialog_AuthorLabel" />
            <Run Text="tommy (tommy.yxd@gmail.com)" />
        </TextBlock>

        <StackPanel Margin="-12,12,0,0"
                    Orientation="Vertical">
            <HyperlinkButton x:Uid="AboutDialog_SourceCodeLink"
                             NavigateUri="https://github.com/filegrid/terminal/" />
            <HyperlinkButton x:Uid="AboutDialog_DocumentationLink" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
